# ==============================================================================
# Project Atlas - Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Security / Service-to-Service Auth
API_KEY=your_secure_service_api_key_here

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mysql_password_here
MYSQL_DATABASE=project_atlas
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE=3600

# LLM Provider Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Vector Database Configuration
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./vector_store

# Confidence & Guardrail Settings
CONFIDENCE_THRESHOLD=0.75
